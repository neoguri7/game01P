# WP-51 recorder checks, run by ctest (demo_record_smoke, demo_record_args).
#   -DEXE=<game01P.exe> -DMODE=record|args -DOUT=<scratch directory>
if(NOT EXE OR NOT MODE OR NOT OUT)
    message(FATAL_ERROR "usage: cmake -DEXE=<game> -DMODE=record|args -DOUT=<dir> -P check_record_output.cmake")
endif()

file(REMOVE_RECURSE "${OUT}")

if(MODE STREQUAL "record")
    # F24: 30 steps at every=2 -> 15 frames and 30 x 800 stereo float frames of audio.
    execute_process(COMMAND "${EXE}" --ember --frames 30 --record "${OUT}"
        RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "record run exited with '${code}'\n${out}\n${err}")
    endif()
    file(GLOB frames "${OUT}/frame_*.png")
    list(LENGTH frames count)
    if(NOT count EQUAL 15)
        message(FATAL_ERROR "expected 15 frames, found ${count}")
    endif()
    foreach(name frame_000000.png frame_000014.png)
        if(NOT EXISTS "${OUT}/${name}")
            message(FATAL_ERROR "missing ${name}")
        endif()
    endforeach()
    if(NOT EXISTS "${OUT}/audio.wav")
        message(FATAL_ERROR "missing audio.wav")
    endif()
    file(READ "${OUT}/audio.wav" head LIMIT 12 HEX)
    string(SUBSTRING "${head}" 0 8 riff)
    string(SUBSTRING "${head}" 16 8 wave)
    if(NOT riff STREQUAL "52494646" OR NOT wave STREQUAL "57415645")
        message(FATAL_ERROR "audio.wav is not a RIFF/WAVE file: ${head}")
    endif()
    file(SIZE "${OUT}/audio.wav" bytes)
    if(bytes LESS 192000 OR bytes GREATER 192512)
        message(FATAL_ERROR "audio.wav is ${bytes} bytes, expected 30 x 800 x 8 = 192000 plus a header")
    endif()
elseif(MODE STREQUAL "args")
    # F25: every bad combination exits non-zero.
    function(expect_failure name)
        execute_process(COMMAND "${EXE}" ${ARGN} RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
        if(code EQUAL 0)
            message(FATAL_ERROR "case '${name}' must exit non-zero but exited 0")
        endif()
    endfunction()
    expect_failure("record without frames" --ember --record "${OUT}")
    file(REMOVE_RECURSE "${OUT}")
    expect_failure("record-every 0" --ember --frames 4 --record "${OUT}" --record-every 0)
    file(REMOVE_RECURSE "${OUT}")
    expect_failure("record-every without record" --ember --frames 4 --record-every 2)
    file(MAKE_DIRECTORY "${OUT}")
    file(WRITE "${OUT}/keep.txt" x)
    expect_failure("non-empty directory" --ember --frames 4 --record "${OUT}")
    if(NOT EXISTS "${OUT}/keep.txt")
        message(FATAL_ERROR "the recorder removed a user file")
    endif()
else()
    message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
